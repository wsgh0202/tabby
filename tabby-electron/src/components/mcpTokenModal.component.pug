.modal-header
    .token-identity
        small.text-muted(*ngIf='token', translate) Edit token
        small.text-muted(*ngIf='!token', translate) Create token
        h3#mcp-token-title.m-0
            span(*ngIf='displayName') {{displayName}}
            span(*ngIf='!displayName', translate) New token
        code.text-muted(*ngIf='token?.preview') {{token?.preview}}
    button.btn.btn-secondary.token-modal-close(type='button', (click)='cancel()', [disabled]='busy', [attr.aria-label]='"Close" | translate')
        i.fas.fa-times(aria-hidden='true')

.token-layout
    nav.token-navigation([attr.aria-label]='navigationLabel | translate')
        button.btn(type='button', (click)='navigate(general)', [class.btn-secondary]='activeSection === "general"', [attr.aria-current]='activeSection === "general" ? "location" : null', translate) General
        button.btn(type='button', (click)='navigate(toolsSection)', [class.btn-secondary]='activeSection === "tools"', [attr.aria-current]='activeSection === "tools" ? "location" : null', translate) Tool capabilities

    .token-form-page(#formPage, (scroll)='updateActiveSection()')
        .alert.alert-warning.mt-3(*ngIf='invalidPermissions', translate) MCP permissions are invalid. Configure this token again before use.
        fieldset([disabled]='busy')
            section#general(#general, data-mcp-section)
                h4(translate) General
                label.form-label(for='mcp-token-name')
                    span(translate) Token name
                    small.text-muted.ms-2(translate) Optional
                input#mcp-token-name.form-control(type='text', [(ngModel)]='name', maxlength='200', autofocus)
                p.text-muted.mt-2.mb-0(translate) If left empty, the token is displayed with its middle characters omitted.

            section#tools(#toolsSection, data-mcp-section)
                .section-heading
                    h4.mb-0(translate) Tool capabilities
                p.text-muted(translate) Choose what the agent can do.
                .capability-package
                    label.permission-row
                        input.form-check-input(type='checkbox', [ngModel]='connectionOperationsEnabled', (ngModelChange)='setConnectionOperations($event)')
                        .permission-copy
                            span(translate) Connection operations
                            small.text-muted(translate) Discover and use the connections included in this token.
                    button.btn.btn-secondary(type='button', (click)='configureConnections()', [disabled]='!connectionOperationsEnabled', translate) Configure connection operations

.alert.alert-danger.mx-3.mb-3(*ngIf='error', role='alert') {{error | translate}}
.alert.alert-warning.mx-3.mb-3(*ngIf='discardPrompt')
    p(translate) Discard unsaved changes?
    button.btn.btn-secondary(type='button', (click)='discardPrompt = false', translate) Continue editing
    button.btn.btn-danger.ms-2(type='button', (click)='discard()', translate) Discard changes
.modal-footer
    button.btn.btn-secondary(type='button', (click)='cancel()', [disabled]='busy', translate) Cancel
    button.btn.btn-primary(type='button', (click)='save()', [disabled]='busy')
        span(*ngIf='token', translate) Save changes
        span(*ngIf='!token', translate) Create token
